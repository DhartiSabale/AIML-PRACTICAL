import math
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats

print("Math module")
print("Factorial of 5:", math.factorial(5))
print("Square root of 49:", math.sqrt(49))
print("Ceil of 4.2:", math.ceil(4.2))
print("Floor of 4.8:", math.floor(4.8))
print("Absolute value of -7.5:", math.fabs(-7.5))
print("Sin(90 degrees):", math.sin(math.radians(90)))
print()

df = pd.read_csv("students.csv")

print("First 5 records")
print(df.head())
print()

print("Null values in each column")
print(df.isnull().sum())
print()

print("Summary statistics")
print(df.describe())
print()

maths_marks = df["maths"].values
science_marks = df["science"].values

print("NumPy statistics (maths marks)")
print("Mean:", np.mean(maths_marks))
print("Median:", np.median(maths_marks))
print("Standard deviation:", np.std(maths_marks))
print("Variance:", np.var(maths_marks))
print()

print("SciPy statistics")
print("Mode of maths marks:", stats.mode(maths_marks, keepdims=False).mode)
correlation, p_value = stats.pearsonr(maths_marks, science_marks)
print("Correlation between maths and science:", round(correlation, 3))
print()

plt.plot(df["name"], df["maths"], marker="o")
plt.title("Maths Marks of Students")
plt.xlabel("Student")
plt.ylabel("Marks")
plt.xticks(rotation=90)
plt.tight_layout()
plt.show()

gender_avg = df.groupby("gender")["maths"].mean()
plt.bar(gender_avg.index, gender_avg.values, color=["orange", "green"])
plt.title("Average Maths Marks by Gender")
plt.xlabel("Gender")
plt.ylabel("Average Marks")
plt.show()

plt.scatter(df["maths"], df["science"], color="red")
plt.title("Maths vs Science Marks")
plt.xlabel("Maths")
plt.ylabel("Science")
plt.show()

plt.hist(df["attendance"], bins=6, color="skyblue", edgecolor="black")
plt.title("Attendance Distribution")
plt.xlabel("Attendance %")
plt.ylabel("Number of Students")
plt.show()
